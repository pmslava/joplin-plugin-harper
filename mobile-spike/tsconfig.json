{
	"compilerOptions": {
		"outDir": "./dist/",
		"module": "commonjs",
		"target": "es2017",
		"lib": ["es2019", "dom"],
		"allowJs": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"baseUrl": ".",
		"paths": {
			"api": ["../api/index"],
			"api/*": ["../api/*"]
		}
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist", "publish", "e2e"]
}
