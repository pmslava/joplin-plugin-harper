{
  "name": "joplin-plugin-harper",
  "version": "1.5.0",
  "description": "Fast, offline, private grammar and spelling checking for the Joplin Markdown editor on desktop and mobile, powered by Harper.",
  "author": "pmslava",
  "homepage": "https://github.com/pmslava/joplin-plugin-harper#readme",
  "bugs": {
    "url": "https://github.com/pmslava/joplin-plugin-harper/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pmslava/joplin-plugin-harper.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dist": "webpack --env joplin-plugin-config=buildMain && webpack --env joplin-plugin-config=buildExtraScripts && webpack --env joplin-plugin-config=createArchive",
    "test": "npm run dist && node test/run.js",
    "setup:e2e": "bash scripts/setup-e2e.sh",
    "test:e2e": "npm run dist && npm run setup:e2e && xvfb-run -a --server-args=\"-screen 0 1920x1080x24\" playwright test",
    "prepare": "npm run dist",
    "update": "npm install -g generator-joplin && yo joplin --node-package-manager npm --update --force",
    "updateVersion": "webpack --env joplin-plugin-config=updateVersion"
  },
  "license": "MIT",
  "keywords": [
    "joplin-plugin",
    "joplin",
    "harper",
    "grammar",
    "spelling",
    "spell-check",
    "linter",
    "proofreading",
    "writing"
  ],
  "devDependencies": {
    "@codemirror/lint": "^6.8.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.26.0",
    "@joplin/lib": "~2.9",
    "@playwright/test": "^1.62.0",
    "@types/node": "^18.7.13",
    "chalk": "^4.1.0",
    "copy-webpack-plugin": "^11.0.0",
    "fs-extra": "^10.1.0",
    "glob": "^8.0.3",
    "playwright": "^1.62.0",
    "tar": "^6.1.11",
    "ts-loader": "^9.3.1",
    "typescript": "^5.4.5",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0"
  },
  "dependencies": {
    "harper.js": "2.7.0"
  },
  "files": [
    "publish"
  ]
}
